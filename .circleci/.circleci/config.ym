version: 2.1

jobs:
  build:
    docker:
      - image: cimg/android:2024.01

    working_directory: ~/project

    steps:
      - checkout

      - run:
          name: Install dependencies
          command: npm install

      - run:
          name: Build APK
          command: |
            cd android
            chmod +x gradlew
            ./gradlew assembleRelease

      - store_artifacts:
          path: android/app/build/outputs/apk/release
